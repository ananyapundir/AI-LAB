HUMAN = 'X'
AI = 'O'
EMPTY = ' '


def init_board():
    return [[EMPTY] * 3 for _ in range(3)]


def print_board(board):
    print()

    for i, row in enumerate(board):
        print(f" {row[0]} | {row[1]} | {row[2]} ")

        if i < 2:
            print("---+---+---")

    print()


def check_win(board, player):
    lines = []

    lines.extend(board)

    lines.extend([
        [board[r][c] for r in range(3)]
        for c in range(3)
    ])

    lines.append([board[i][i] for i in range(3)])
    lines.append([board[i][2 - i] for i in range(3)])

    return any(
        all(cell == player for cell in line)
        for line in lines
    )


def is_full(board):
    return all(
        cell != EMPTY
        for row in board
        for cell in row
    )


def empty_cells(board):
    return [
        (r, c)
        for r in range(3)
        for c in range(3)
        if board[r][c] == EMPTY
    ]


def minimax(board, depth, is_maximizing):

    if check_win(board, AI):
        return 10 - depth


    if check_win(board, HUMAN):
        return depth - 10


    if is_full(board):
        return 0

    if is_maximizing:
        best = -1000

        for r, c in empty_cells(board):
            board[r][c] = AI

            score = minimax(
                board,
                depth + 1,
                False
            )

            board[r][c] = EMPTY

            best = max(best, score)

        return best

    else:
        best = 1000

        for r, c in empty_cells(board):
            board[r][c] = HUMAN

            score = minimax(
                board,
                depth + 1,
                True
            )

            board[r][c] = EMPTY

            best = min(best, score)

        return best


def ai_move(board):
    best_score = -1000
    best_move = None

    for r, c in empty_cells(board):
        board[r][c] = AI

        score = minimax(
            board,
            0,
            False
        )

        board[r][c] = EMPTY

        if score > best_score:
            best_score = score
            best_move = (r, c)

    if best_move is not None:
        board[best_move[0]][best_move[1]] = AI

        print(
            f"AI plays: row {best_move[0]}, "
            f"col {best_move[1]}"
        )


def human_move(board):
    while True:
        try:
            raw = input(
                "Enter your move (row col), "
                "0-indexed (0 0 to 2 2): "
            )

            row, col = map(int, raw.split())

        except ValueError:
            print("Invalid input. Enter two numbers.")
            continue

        if not (0 <= row <= 2 and 0 <= col <= 2):
            print("Invalid move, try again.")
            continue

        if board[row][col] != EMPTY:
            print("Cell already occupied, try again.")
            continue

        board[row][col] = HUMAN
        return


def main():
    board = init_board()

    print(
        f"Tic-Tac-Toe: You are '{HUMAN}', "
        f"AI is '{AI}'"
    )

    print_board(board)

    while True:

        human_move(board)
        print_board(board)

        if check_win(board, HUMAN):
            print("You win!")
            break

        if is_full(board):
            print("It's a draw!")
            break

  
        ai_move(board)
        print_board(board)

        if check_win(board, AI):
            print("AI wins!")
            break

        if is_full(board):
            print("It's a draw!")
            break


if __name__ == "__main__":
    main()

   
  
