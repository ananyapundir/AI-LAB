def parse(expression):
    name, args = expression.strip().split("(")
    return tuple([name.strip()] +
                 [x.strip() for x in args[:-1].split(",")])


def substitute(term, sub):
    if isinstance(term, str):
        while term in sub:
            term = sub[term]
        return term

    return tuple([term[0]] +
                 [substitute(x, sub) for x in term[1:]])


def unify(a, b, sub):
    a = substitute(a, sub)
    b = substitute(b, sub)

    if a[0] != b[0] or len(a) != len(b):
        return None

    for x, y in zip(a[1:], b[1:]):
        x = substitute(x, sub)
        y = substitute(y, sub)

        if x == y:
            continue
        elif x.islower() and x.isalpha():
            sub[x] = y
        elif y.islower() and y.isalpha():
            sub[y] = x
        else:
            return None

    return sub


def match(premises, facts, sub=None):
    if sub is None:
        sub = {}

    if not premises:
        return [sub]

    results = []

    for fact in facts:
        new_sub = unify(premises[0], fact, sub.copy())

        if new_sub is not None:
            results.extend(
                match(premises[1:], facts, new_sub)
            )

    return results


def forward_chaining(kb, rules, goal):
    iteration = 1

    while True:
        new_facts = []

        print("\nIteration:", iteration)

        for premises, conclusion in rules:
            substitutions = match(premises, kb)

            for sub in substitutions:
                fact = substitute(conclusion, sub)

                if fact not in kb and fact not in new_facts:
                    new_facts.append(fact)
                    print("New Fact:", fact)

        if not new_facts:
            break

        kb.extend(new_facts)
        iteration += 1

    print("\nFinal Knowledge Base:")

    for fact in kb:
        print(fact)

    if goal in kb:
        print("\nSUCCESS: Goal Proved!")
    else:
        print("\nFAILURE: Goal Not Proved!")


print("FORWARD CHAINING IN FIRST ORDER LOGIC")

kb = []
n = int(input("\nEnter number of facts: "))

for i in range(n):
    fact = input("Enter fact: ")
    kb.append(parse(fact))

rules = []
r = int(input("\nEnter number of rules: "))

for i in range(r):
    print("\nRule", i + 1)

    premises = input("Enter premises (& separated): ")
    conclusion = input("Enter conclusion: ")

    premise_list = [
        parse(x) for x in premises.split("&")
    ]

    rules.append((premise_list, parse(conclusion)))

goal = parse(input("\nEnter goal: "))

print("\nInitial Knowledge Base:", kb)
print("\nGoal:", goal)

forward_chaining(kb, rules, goal)



