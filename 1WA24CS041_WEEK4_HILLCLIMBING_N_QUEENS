def cost(q):
    c = 0
    for i in range(4):
        for j in range(i+1, 4):
            if q[i] == q[j] or abs(q[i]-q[j]) == j-i:
                c += 1
    return c


def hill_climbing():
    q = [3, 1, 2, 0]

    while True:
        current = cost(q)
        best = q[:]
        minimum = current

        print("\nCurrent:", q, "Cost:", current)

        for i in range(4):
            for j in range(i+1, 4):

                q[i], q[j] = q[j], q[i]
                c = cost(q)

                print("Neighbour:", q, "Cost:", c)

                if c < minimum:
                    minimum = c
                    best = q[:]

                q[i], q[j] = q[j], q[i]

        if minimum == current:
            break

        q = best

    print("\nFinal State:", q)
    print("Final Cost:", cost(q))

    if cost(q) == 0:
        print("Goal State Reached!")


hill_climbing()
