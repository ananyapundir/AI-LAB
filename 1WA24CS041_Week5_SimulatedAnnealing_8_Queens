import random
import math


def cost(q):
    c = 0
    for i in range(8):
        for j in range(i+1, 8):
            if q[i] == q[j] or abs(q[i]-q[j]) == j-i:
                c += 1
    return c


def simulated_annealing():

    q = list(range(8))
    random.shuffle(q)

    best = q[:]
    best_cost = cost(q)

    T = 10

    while T > 0.01 and cost(q) > 0:

        next_state = q[:]

        i, j = random.sample(range(8), 2)
        next_state[i], next_state[j] = next_state[j], next_state[i]

        current = cost(q)
        new = cost(next_state)

        dE = current - new

        if dE > 0 or random.random() < math.exp(dE/T):
            q = next_state

        if cost(q) < best_cost:
            best = q[:]
            best_cost = cost(q)

        T = T * 0.995

    if cost(q) == 0:
        best = q[:]
        best_cost = 0

    print("\nFinal State:", best)
    print("Final Cost:", best_cost)

    if best_cost == 0:
        print("Solution Found!")

        for i in range(8):
            for j in range(8):
                if best[j] == i:
                    print("Q", end=" ")
                else:
                    print(".", end=" ")
            print()


simulated_annealing()
